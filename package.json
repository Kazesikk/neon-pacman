{
  "name": "neon-pacman",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:portable": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "electron": "39.2.7",
    "electron-builder": "26.0.12"
  },
  "description": "Neon Pac-Man - a customizable arcade game for desktop",
  "author": "Kazesikk",
  "homepage": "https://github.com/Kazesikk",
  "license": "MIT",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.kazesikk.neonpacman",
    "productName": "Neon Pac-Man",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronDist": "node_modules/electron/dist"
  }
}
